Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^index\.php$ - [L]

    RewriteCond %{DOCUMENT_ROOT}/kintu/listing/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/kintu/listing/public/$1 -d
    RewriteRule ^(.+)$ listing/public/$1 [L]

    RewriteCond %{DOCUMENT_ROOT}/listing/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/listing/public/$1 -d
    RewriteRule ^(.+)$ listing/public/$1 [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
